# ============================================================
# Daytona API — .env.example
# Copy to .env and fill in real values.
# ============================================================

# ---------- Server ----------
PORT=3001

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=pass
DB_DATABASE=application_ctx

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Authentication ----------
# Which identity provider handles user auth.
# Values: 'auth0' (default) | 'workos'
# Flip to 'workos' AFTER configuring the WORKOS_OIDC_* vars below.
AUTH_PROVIDER=auth0

# ---------- OIDC (Auth0 / Dex — current default provider) ----------
OIDC_CLIENT_ID="REPLACE_ME_client_id"
OIDC_ISSUER_BASE_URL="REPLACE_ME_issuer_url_no_trailing_slash"
OIDC_AUDIENCE="REPLACE_ME_audience"

# Auth0 Management API (linked accounts, MFA enrollment, user provisioning).
# Set enabled=true to activate; otherwise the endpoints that call the Management
# API return 404 or 503.
OIDC_MANAGEMENT_API_ENABLED=false
OIDC_MANAGEMENT_API_CLIENT_ID=
OIDC_MANAGEMENT_API_CLIENT_SECRET=
OIDC_MANAGEMENT_API_AUDIENCE=

# Optional: rewrite JWKS host when the API runs inside Docker but the OIDC
# issuer's public hostname differs from the container-network hostname.
# Example: PUBLIC_OIDC_DOMAIN=https://auth.staging.daytona.io
# PUBLIC_OIDC_DOMAIN=

# ---------- WorkOS AuthKit (PoC — Standalone Connect / Mode B) ----------
# Only used when AUTH_PROVIDER=workos.
# Get these from WorkOS Dashboard -> Applications -> your app.
# ISSUER must be your AuthKit custom domain (or the default *.authkit.app).
WORKOS_OIDC_ISSUER=https://authkit.example.com
WORKOS_OIDC_CLIENT_ID="client_REPLACE_ME"
# AUDIENCE typically equals CLIENT_ID for AuthKit.
WORKOS_OIDC_AUDIENCE="client_REPLACE_ME"

# ---------- Dashboard URLs ----------
DEFAULT_SNAPSHOT=ubuntu:22.04
DASHBOARD_URL=http://localhost:3000/dashboard
DASHBOARD_BASE_API_URL=http://localhost:3000

# ---------- PostHog ----------
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_TRACK_LIST_SANDBOXES_PAGINATED=

# ---------- Transient Registry ----------
TRANSIENT_REGISTRY_URL=http://registry:5000
TRANSIENT_REGISTRY_ADMIN=admin
TRANSIENT_REGISTRY_PASSWORD="REPLACE_ME"
TRANSIENT_REGISTRY_PROJECT_ID=daytona

# ---------- Internal Registry ----------
INTERNAL_REGISTRY_URL=http://registry:5000
INTERNAL_REGISTRY_ADMIN=admin
INTERNAL_REGISTRY_PASSWORD="REPLACE_ME"
INTERNAL_REGISTRY_PROJECT_ID=daytona

# ---------- SMTP ----------
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_EMAIL_FROM="Daytona Team <no-reply@daytona.io>"

# ---------- S3 ----------
S3_ENDPOINT=http://minio:9000
S3_STS_ENDPOINT=http://minio:9000/minio/v1/assume-role
S3_REGION=us-east-1
S3_ACCESS_KEY="REPLACE_ME"
S3_SECRET_KEY="REPLACE_ME"
S3_DEFAULT_BUCKET=daytona
S3_ACCOUNT_ID=/
S3_ROLE_NAME=/

# ---------- Environment Metadata ----------
ENVIRONMENT=dev
MAX_AUTO_ARCHIVE_INTERVAL=43200

# ---------- OTel ----------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ---------- Maintenance Mode ----------
MAINTENANCE_MODE=false

# ---------- Proxy ----------
PROXY_DOMAIN=proxy.localhost:4000
PROXY_PROTOCOL=http
PROXY_API_KEY="REPLACE_ME"

# ---------- Audit Logs ----------
AUDIT_LOG_RETENTION_DAYS=
AUDIT_CONSOLE_LOG_ENABLED=

# ---------- Cron ----------
# See https://www.iana.org/time-zones
CRON_TIMEZONE=

# ---------- SSH Gateway ----------
SSH_GATEWAY_API_KEY="REPLACE_ME"
SSH_GATEWAY_COMMAND="ssh -p 2222 {{TOKEN}}@localhost"
SSH_GATEWAY_PUBLIC_KEY="REPLACE_ME_base64_encoded_public_key"
SSH_GATEWAY_URL=localhost:2222

# ---------- Preview / Proxy Templates ----------
PROXY_TEMPLATE_URL=http://{{PORT}}-{{sandboxId}}.proxy.localhost:4000
PROXY_TOOLBOX_BASE_URL=http://proxy.localhost:4000

# ---------- Pylon ----------
PYLON_APP_ID=

# ---------- Billing ----------
BILLING_API_URL=

# ---------- Default Runner ----------
DEFAULT_RUNNER_DOMAIN=localhost:3003
DEFAULT_RUNNER_API_URL=http://localhost:3003
DEFAULT_RUNNER_PROXY_URL=http://localhost:3003
DEFAULT_RUNNER_API_KEY="REPLACE_ME"
DEFAULT_RUNNER_CPU=4
DEFAULT_RUNNER_MEMORY=8
DEFAULT_RUNNER_DISK=50
DEFAULT_RUNNER_NAME=default

# ---------- API Key Cache TTLs ----------
API_KEY_VALIDATION_CACHE_TTL_SECONDS=10
API_KEY_USER_CACHE_TTL_SECONDS=60

# ---------- Admin API + Admin Quotas ----------
ADMIN_API_KEY="REPLACE_ME_32_char_min"
ADMIN_TOTAL_CPU_QUOTA=10
ADMIN_TOTAL_MEMORY_QUOTA=10
ADMIN_TOTAL_DISK_QUOTA=10
ADMIN_MAX_CPU_PER_SANDBOX=4
ADMIN_MAX_MEMORY_PER_SANDBOX=8
ADMIN_MAX_DISK_PER_SANDBOX=10
ADMIN_SNAPSHOT_QUOTA=100
ADMIN_MAX_SNAPSHOT_SIZE=100
ADMIN_VOLUME_QUOTA=100

# ---------- User Verification ----------
SKIP_USER_EMAIL_VERIFICATION=true

# ---------- OTel Collector API Key ----------
OTEL_COLLECTOR_API_KEY="REPLACE_ME"

# ---------- Sandbox OTel Endpoint ----------
SANDBOX_OTEL_ENDPOINT_URL=http://host.docker.internal:4318

# ---------- Encryption ----------
ENCRYPTION_KEY="REPLACE_ME_32_char_min"
ENCRYPTION_SALT="REPLACE_ME_32_char_min"

# ---------- Health Check ----------
HEALTH_CHECK_API_KEY="REPLACE_ME"

# ---------- Billing API ----------
BILLING_API_KEY="REPLACE_ME"

# ---------- Runner Cleanup ----------
RUNNER_CLEANUP_TOOL_API_KEY="REPLACE_ME"

# ---------- User Management API Key ----------
USER_MANAGEMENT_API_KEY="REPLACE_ME"

# ---------- Dashboard Serving ----------
DONT_SERVE_DASHBOARD=true

# ---------- Stripe Projects ----------
STRIPE_PROJECTS_API_KEY="REPLACE_ME"

# ---------- Sandbox Search Publish ----------
SANDBOX_SEARCH_PUBLISH_ENABLED=
SANDBOX_SEARCH_PUBLISH_STORAGE_ADAPTER=
SANDBOX_SEARCH_PUBLISH_OPENSEARCH_INDEX_NAME=
SANDBOX_SEARCH_PUBLISH_NUMBER_OF_SHARDS=
SANDBOX_SEARCH_PUBLISH_NUMBER_OF_REPLICAS=
