# Main API Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=pass
DB_DATABASE=application_ctx

# Backoffice Database (separate DB for audit logs and users)
BACKOFFICE_DB_HOST=db
BACKOFFICE_DB_PORT=5432
BACKOFFICE_DB_USERNAME=user
BACKOFFICE_DB_PASSWORD=pass
BACKOFFICE_DB_DATABASE=backoffice
BACKOFFICE_DB_MIGRATIONS_RUN=true

# Server
PORT=8080
NODE_ENV=development

# Basic Auth for backoffice (fallback)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# OIDC Configuration (Google OAuth)
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=GOCSPX-your-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
OIDC_AUDIENCE=
OIDC_ALLOWED_DOMAIN=daytona.io

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:8000

# Session JWT
JWT_SECRET=change-this-in-production-to-a-secure-random-string
JWT_EXPIRES_IN=15m

# Auth Mode (both = supports Basic Auth + OIDC)
AUTH_MODE=both

# CORS
CORS_ORIGIN=http://localhost:8000

# External API Configuration (for webhook initialization)
EXTERNAL_API_URL=https://app.daytona.io/api
ADMIN_API_KEY=your-admin-key-here

# Admin Organization ID (for general snapshots)
ADMIN_ORG_ID=00000000-0000-0000-0000-000000000000

# --- Mali Assistant ---

# Anthropic (required — models have sensible defaults if not set)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6                      # default: claude-sonnet-4-6
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001     # default: claude-haiku-4-5-20251001
# MALI_SUGGESTION_MODEL=claude-haiku-4-5-20251001        # default: claude-haiku-4-5-20251001
# MALI_MEMORY_CONTEXT_MESSAGES=5                         # default: 5

# Grafana
MALI_GRAFANA_URL=https://grafana.example.com
MALI_GRAFANA_TOKEN=glsa_your-grafana-service-account-token

# Database (read replica — direct PostgreSQL connection)
MALI_DB_HOST=your-read-replica.rds.amazonaws.com
MALI_DB_PORT=5432
MALI_DB_USERNAME=readonly_user
MALI_DB_PASSWORD=your-password
MALI_DB_DATABASE=application_ctx
# MALI_DB_TLS_ENABLED=true

# OpenSearch (basic auth)
MALI_OPENSEARCH_URL=https://your-opensearch-cluster:9200
MALI_OPENSEARCH_USERNAME=admin
MALI_OPENSEARCH_PASSWORD=your-password

# ClickHouse
MALI_CLICKHOUSE_SERVICE_ID=00000000-0000-0000-0000-000000000000
MALI_CLICKHOUSE_KEY_ID=your-clickhouse-key-id
MALI_CLICKHOUSE_KEY_SECRET=your-clickhouse-key-secret

# PostHog
MALI_POSTHOG_API_KEY=phx_your-posthog-key
MALI_POSTHOG_PROJECT_ID=123456

# Sandbox / GitHub (defaults, per-user keys override via Settings)
MALI_GITHUB_PAT=github_pat_your-token
MALI_GITHUB_REPO=org/repo
