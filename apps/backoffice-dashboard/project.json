{
  "name": "backoffice-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backoffice-dashboard/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/backoffice-dashboard",
        "configFile": "apps/backoffice-dashboard/vite.config.ts",
        "tsConfig": "apps/backoffice-dashboard/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "backoffice-dashboard:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "backoffice-dashboard:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "backoffice-dashboard:build:production",
          "hmr": false
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd {projectRoot} && prettier --write \"**/*.{ts,tsx,js,jsx,json,css,mjs,html}\" --config ../../.prettierrc"
      }
    }
  }
}
