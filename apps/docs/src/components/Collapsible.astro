---
interface Props {
  title: string
  collapsedRows?: number
}

const { title, collapsedRows = 5 } = Astro.props
---

<div
  class="collapsible"
  data-collapsible
  data-collapsed-rows={collapsedRows}
  data-expanded="false"
>
  <div class="header">
    <span class="title">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      {title}
    </span>
  </div>

  <div class="body" data-collapsible-body>
    <slot />
    <div class="fade" data-collapsible-fade aria-hidden="true"></div>
  </div>

  <button
    type="button"
    class="toggle"
    data-collapsible-toggle
    data-label-more="Show more"
    data-label-less="Show less"
    aria-expanded="false"
  >
    <span data-collapsible-label>Show more</span>
    <svg
      class="chevron"
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
</div>

<style>
  .collapsible {
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    background-color: var(--block-bg-color);
    overflow: hidden;
    margin: 1.5rem 0;
    scroll-margin-top: 6rem;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary-text-color);
  }

  .title > svg {
    flex-shrink: 0;
    color: var(--secondary-text-color);
  }

  .body {
    position: relative;
    padding: 0 1rem;
    max-height: 18rem;
    overflow: hidden;
    transition: max-height 0.25s ease-in-out;
  }

  .collapsible[data-expanded='true'] .body {
    max-height: none;
  }

  .body :global(table) {
    border-collapse: collapse;
    width: 100%;
    color: var(--primary-text-color);
    margin: 1rem 0;
  }

  .body :global(th),
  .body :global(td) {
    padding: 0.5rem;
    text-align: left;
    word-break: break-word;
    max-width: 10vw;
  }

  .body :global(td) {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.01rem;
    border-bottom: 1px solid var(--border-extra);
  }

  .body :global(th) {
    font-family: 'Berkeley Mono', monospace;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.0075rem;
    text-transform: uppercase;
    border-bottom: 3px solid var(--border-extra);
  }

  .fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 4rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--block-bg-color));
  }

  .collapsible[data-expanded='true'] .fade {
    display: none;
  }

  .toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.625rem 1rem;
    border: none;
    border-top: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--secondary-text-color);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .toggle:hover {
    background-color: var(--cta-surface-neutral-primary);
    color: var(--primary-text-color);
  }

  .toggle > svg {
    flex-shrink: 0;
    transition: transform 0.2s ease-in-out;
  }

  .collapsible[data-expanded='true'] .toggle > svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const instances = new Set<
    HTMLElement & { __collapsibleRender?: () => void }
  >()
  let resizeBound = false

  function handleResize() {
    for (const el of instances) {
      if (!el.isConnected) {
        instances.delete(el)
        continue
      }
      el.__collapsibleRender?.()
    }
  }

  function setupCollapsible(
    el: HTMLElement & { __collapsibleRender?: () => void }
  ) {
    if (el.dataset.collapsibleReady === 'true') {
      return
    }
    el.dataset.collapsibleReady = 'true'

    const body = el.querySelector<HTMLElement>('[data-collapsible-body]')
    const toggle = el.querySelector<HTMLElement>('[data-collapsible-toggle]')
    const fade = el.querySelector<HTMLElement>('[data-collapsible-fade]')
    const label = el.querySelector<HTMLElement>('[data-collapsible-label]')
    if (!body || !toggle || !fade || !label) {
      return
    }

    const collapsedRows = parseInt(el.dataset.collapsedRows || '5', 10)
    const labelMore = toggle.dataset.labelMore || 'Show more'
    const labelLess = toggle.dataset.labelLess || 'Show less'
    const table = body.querySelector('table')

    const totalRows = table?.tBodies[0]?.rows.length ?? 0

    if (!table || totalRows <= collapsedRows) {
      body.style.maxHeight = 'none'
      fade.style.display = 'none'
      toggle.style.display = 'none'
      return
    }

    function collapsedHeight(): number {
      let height = 0
      if (table!.tHead) {
        height += table!.tHead.offsetHeight
      }
      const rows = Array.from(table!.tBodies[0].rows)
      for (let i = 0; i < Math.min(collapsedRows, rows.length); i++) {
        height += rows[i].offsetHeight
      }
      return height + table!.offsetTop
    }

    function setMaxHeight(target: number, immediate: boolean) {
      const current = body!.offsetHeight
      const distance = Math.abs(target - current)
      const duration = immediate
        ? 0
        : Math.min(0.5, Math.max(0.2, distance / 2400))
      body!.style.transitionDuration = `${duration}s`
      body!.style.maxHeight = `${target}px`
    }

    function render(immediate = false) {
      const expanded = el.dataset.expanded === 'true'
      if (expanded) {
        setMaxHeight(body!.scrollHeight, immediate)
        label!.textContent = labelLess
        toggle!.setAttribute('aria-expanded', 'true')
      } else {
        setMaxHeight(collapsedHeight(), immediate)
        label!.textContent = labelMore
        toggle!.setAttribute('aria-expanded', 'false')
      }
    }

    toggle.addEventListener('click', () => {
      const willExpand = el.dataset.expanded !== 'true'
      el.dataset.expanded = willExpand ? 'true' : 'false'
      render()

      if (!willExpand) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
    })

    el.__collapsibleRender = () => render(true)
    instances.add(el)

    render(true)
  }

  function initCollapsibles() {
    document
      .querySelectorAll<HTMLElement>('[data-collapsible]')
      .forEach(setupCollapsible)

    if (!resizeBound) {
      window.addEventListener('resize', handleResize)
      resizeBound = true
    }
  }

  initCollapsibles()
  document.addEventListener('astro:page-load', initCollapsibles)
</script>
