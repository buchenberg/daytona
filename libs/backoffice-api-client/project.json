{
  "name": "backoffice-api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backoffice-api-client",
  "projectType": "library",
  "targets": {
    "generate:api-client": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "yarn run openapi-generator-cli generate -i dist/apps/backoffice-api/openapi.json -g typescript-axios --additional-properties=supportsES6=true,typescriptThreePlus=true,withSeparateModelsAndApi=true,apiPackage=api,modelPackage=models,useTags=true,enumPropertyNaming=UPPERCASE --type-mappings=DateTime=Date -o libs/backoffice-api-client/src"
        ],
        "parallel": false
      },
      "dependsOn": [
        {
          "target": "openapi",
          "projects": "backoffice-api"
        }
      ]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "inputs": ["default", "{projectRoot}/package.json"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backoffice-api-client",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "packageJson": "{projectRoot}/package.json",
        "main": "{projectRoot}/src/index.ts",
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd {projectRoot} && prettier --write \"**/*.{ts,json}\" --config ../../.prettierrc"
      }
    }
  }
}
